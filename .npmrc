linker=isolated-io
ignore-scripts=false
# Link workspace packages to each other instead of resolving them from the
# registry. Without this, `next` and `devtools` consume the *published*
# @next-rsc-debug/core, so a local change to core is invisible to them until it
# is released — cross-package edits fail with confusing "not a function" or
# "has no exported member" errors.
link-workspace-packages=true
