{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "next-rsc-debug": [
        "../../packages/next/src/index.ts"
      ],
      "next-rsc-debug/server": [
        "../../packages/next/src/server.ts"
      ],
      "next-rsc-debug/route": [
        "../../packages/next/src/route.ts"
      ],
      "@next-rsc-debug/devtools": [
        "../../packages/devtools/src/index.ts"
      ],
      "@next-rsc-debug/core": [
        "../../packages/core/src/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
