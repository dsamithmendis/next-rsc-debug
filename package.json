{
  "name": "next-rsc-debug",
  "version": "0.1.0",
  "private": true,
  "description": "Observability and debugging toolkit for Next.js App Router applications",
  "author": "Samith Mendis",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4"
  }
}
