{
  "name": "next-rsc-debug",
  "version": "0.1.0",
  "private": true,
  "description": "Observability and debugging toolkit for Next.js App Router applications",
  "author": "Samith Mendis",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}