{
  "name": "next-rsc-debug",
  "version": "0.1.5",
  "description": "Observability and debugging toolkit for Next.js App Router applications",
  "author": "Samith Mendis",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "import": "./dist/route.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint src --ext .ts"
  },
"dependencies": {
    "@next-rsc-debug/core": "0.1.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "executable": false
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
